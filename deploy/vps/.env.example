# Copy to /var/www/foodfox/apps/web/.env on VPS
NODE_ENV=production
PORT=3030

# Local Postgres (docker compose postgres on 5433)
DATABASE_URL=postgresql://foodfox:foodfox_local@127.0.0.1:5433/foodfox
DATABASE_SSL=false
POSTGRES_PASSWORD=foodfox_local

# Heli LLM — ключ с getheli.ru
FOX_HELI_API_KEY=
HELI_BASE_URL=https://getheli.ru/v1
HELI_CHAT_MODEL=gpt-4o-mini

# Подпись сессии личного кабинета (openssl rand -hex 32)
SESSION_SECRET=

# Локальное хранение PDF отчётов (на VPS: /var/www/foodfox/data/reports)
REPORT_STORAGE_DIR=
