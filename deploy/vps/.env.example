# Copy to /var/www/foodfox/apps/web/.env on VPS
NODE_ENV=production
PORT=3030

# Local Postgres (docker compose postgres on 5433)
DATABASE_URL=postgresql://foodfox:foodfox_local@127.0.0.1:5433/foodfox
DATABASE_SSL=false
POSTGRES_PASSWORD=foodfox_local

# Heli LLM — ключ с getheli.ru
FOX_HELI_API_KEY=
HELI_BASE_URL=https://getheli.ru/v1
HELI_CHAT_MODEL=gpt-4o-mini

# Подпись access/refresh токенов (openssl rand -hex 32)
SESSION_SECRET=

# Партнёрская программа: ключ шифрования паспортных данных и сканов партнёров (openssl rand -base64 32).
# Без него на проде анкета не принимает документы. Ключ не менять: старые данные не откроются.
FOX_PD_KEY=
# Зашифрованные сканы (по умолчанию /var/www/foodfox/data/partner-pd)
FOX_PD_DIR=

# Локальное хранение PDF отчётов (на VPS: /var/www/foodfox/data/reports)
REPORT_STORAGE_DIR=

# Уведомления сотрудникам (админка → «Уведомления»). Без ключей события копятся, но не отправляются.
# Почта: SMTP-ящик, например Яндекс 360 (smtp.yandex.ru, 465) с паролем приложения.
FOX_SMTP_HOST=
FOX_SMTP_PORT=465
FOX_SMTP_USER=
FOX_SMTP_PASS=
FOX_SMTP_FROM="FoodFox <noreply@example.ru>"
# Telegram: бот от @BotFather; сотрудник подключает свой чат кнопкой в профиле админки.
FOX_TELEGRAM_BOT_TOKEN=
FOX_TELEGRAM_BOT_NAME=
