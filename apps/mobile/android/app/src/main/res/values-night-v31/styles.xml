<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash instead of windowBackground: the same
         green and lime seed, with no icon disc, so it hands over to the
         Flutter splash without a visible change. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fox_bg_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_seed</item>
    </style>
</resources>
